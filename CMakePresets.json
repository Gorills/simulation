{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WORLD_SIM_BUILD_TESTS": "ON",
        "WORLD_SIM_BUILD_GDEXTENSION": "ON",
        "GODOTCPP_API_VERSION": "4.7",
        "GODOTCPP_PRECISION": "single"
      }
    },
    {
      "name": "native",
      "displayName": "Fast native development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WORLD_SIM_BUILD_GDEXTENSION": "OFF"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Native ASan+UBSan verification (GCC/Clang)",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "dev",
      "displayName": "Local Godot development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GODOTCPP_TARGET": "template_debug"
      }
    },
    {
      "name": "release",
      "displayName": "Local release verification",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GODOTCPP_TARGET": "template_release"
      }
    }
  ],
  "buildPresets": [
    {"name": "native", "configurePreset": "native"},
    {"name": "sanitize", "configurePreset": "sanitize"},
    {"name": "dev", "configurePreset": "dev"},
    {"name": "release", "configurePreset": "release"}
  ],
  "testPresets": [
    {"name": "native", "configurePreset": "native", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}},
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}
  ]
}
