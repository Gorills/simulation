[configuration]
entry_symbol = "world_sim_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug = "res://bin/libworld_sim.template_debug.so"
linux.release = "res://bin/libworld_sim.template_release.so"
windows.debug = "res://bin/world_sim.template_debug.dll"
windows.release = "res://bin/world_sim.template_release.dll"
macos.debug = "res://bin/libworld_sim.template_debug.dylib"
macos.release = "res://bin/libworld_sim.template_release.dylib"
